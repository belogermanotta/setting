[init]
  defaultBranch = main
[core]
  editor = nvim
  autocrlf = true
[pull]
  rebase = true
  autostash = true
[push]
  default = simple
[alias]
  st = status -sb
  co = checkout
  br = branch -vv
  lg = log --oneline --decorate --graph -20
  amend = commit --amend --no-edit
  unstage = restore --staged

